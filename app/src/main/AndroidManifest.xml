<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Projet remis à zéro (voir MainActivity.kt) : permissions retirées, seront
         réajoutées au fur et à mesure de la reconstruction de chaque fonctionnalité. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Lot 1 "contrôle téléphone" : permission "normale" (accordée automatiquement, pas de
         dialogue runtime) qui permet à AlarmClock.ACTION_SET_ALARM/ACTION_SET_TIMER de sauter
         l'écran de confirmation (EXTRA_SKIP_UI) : voir DeviceController.
         BUG SIGNALÉ PERSISTANT confirmé par l'utilisateur (texte d'erreur exact obtenu grâce au
         diagnostic Result<Unit>) : "SecurityException: Permission Denial: starting Intent
         { act=android.intent.action.SET_ALARM cmp=com.android.deskclock/.HandleSetAlarmActivity }"
         Note : android.permission.SET_ALARM (ci-dessus) N'EST PAS la permission requise ici : c'est
         une confusion très répandue (même nom en apparence). L'appli Horloge d'AOSP/Pixel
         (com.android.deskclock) protège son activité HandleSetAlarmActivity, celle qui reçoit
         réellement ACTION_SET_ALARM, avec une permission complètement différente et plus
         ancienne : com.android.alarm.permission.SET_ALARM (préfixe com.android.alarm, pas
         android). Les deux existent en parallèle dans l'écosystème Android pour des raisons
         historiques ; il faut déclarer les DEUX pour couvrir tous les appareils/apps Horloge. -->
    <uses-permission android:name="android.permission.SET_ALARM" />
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />

    <!-- Lot 2 "contrôle téléphone" : permissions dangereuses, demandées à l'exécution
         (voir MainActivity.permissionLauncher) avant tout envoi de SMS ou appel. -->
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.CALL_PHONE" />

    <!-- Lot 3 "contrôle téléphone" : lecture/création de contacts natifs, demandées à
         l'exécution comme les permissions ci-dessus. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />

    <!-- Lot 4 "contrôle téléphone" : position GPS/réseau, demandée à l'exécution. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Lot 5 "contrôle téléphone" : accès complet au stockage partagé (recherche/suppression
         de fichiers). MANAGE_EXTERNAL_STORAGE (Android 10+) ne peut être accordée que via un
         écran Réglages dédié (voir StorageController) : WRITE/READ_EXTERNAL_STORAGE couvrent
         Android 9 et moins (maxSdkVersion 32 : ignorée par le système au-delà, comme il se
         doit depuis le passage au scoped storage). -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />

    <!-- Lot 7 "contrôle téléphone" : notifications, permission dangereuse depuis Android 13
         (API 33), demandée à l'exécution (sans objet sur les versions antérieures). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Agenda (voir CalendarController) : lecture/écriture du calendrier LOCAL Android
         (CalendarContract), synchronisé avec Google Agenda par le système lui-même si le
         compte Google du téléphone a la synchro Agenda active : ce n'est PAS l'API Google
         Calendar en ligne, donc aucun ID client OAuth requis pour ça (voir le commentaire
         d'en-tête de CalendarController.kt). -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />

    <!-- Déclaration facultative : indique qu'on utilise le flash si présent, sans empêcher
         l'installation sur un appareil qui n'en a pas (required="false"). -->
    <uses-feature android:name="android.hardware.camera.flash" android:required="false" />

    <!-- BUG SIGNALÉ : réveil/minuteur répondaient "aucune appli Horloge trouvée" alors que
         l'appli existe bien sur l'appareil. Cause réelle : depuis Android 11 (API 30), le
         "package visibility" empêche par défaut une appli de résoudre un intent implicite
         vers une autre appli tant qu'elle ne l'a pas explicitement déclaré ici. targetSdk 35
         est largement concerné. Sans ce bloc, startActivity() sur ACTION_SET_ALARM/
         ACTION_SET_TIMER/geo: peut lever ActivityNotFoundException même si une appli
         Horloge/Cartes est bien installée. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.SET_ALARM" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SET_TIMER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
    </queries>

    <!-- Demande un tas mémoire plus grand au système : utile pour les modèles IA
         embarqués (Gemini Nano/AICore tourne dans un processus système séparé et n'est pas
         concerné, mais de futurs modèles chargés directement dans le processus de l'appli,
         type MediaPipe/ONNX Runtime, en ont besoin). Ne garantit pas une RAM illimitée : la
         limite réelle dépend toujours de l'appareil (Android l'accorde au mieux). -->
    <application
        android:name=".JarvisApplication"
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher"
        android:theme="@style/Theme.Jarvis"
        android:largeHeap="true"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title" />

        <activity
            android:name=".VaultActivity"
            android:exported="false"
            android:label="@string/vault_title" />

        <activity
            android:name=".EmailConfigActivity"
            android:exported="false"
            android:label="@string/email_title" />

        <!-- Lot 8 "contrôle téléphone" : lecture des notifications système des autres applis
             (voir JarvisNotificationListenerService). BIND_NOTIFICATION_LISTENER_SERVICE est un
             permission "signature" détenue par le système : exported="false" + cette valeur
             android:permission garantissent que seul le système peut lier ce service, jamais
             une autre appli tierce. -->
        <service
            android:name=".JarvisNotificationListenerService"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

    </application>

</manifest>

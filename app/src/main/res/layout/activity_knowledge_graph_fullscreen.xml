<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#05070C">

    <com.jarvis.assistant.KnowledgeGraphView
        android:id="@+id/fullscreenGraph"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical"
        android:paddingTop="48dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="✦ MÉMOIRE — ASTRE"
            android:textColor="#D4AF37"
            android:textSize="18sp"
            android:textStyle="bold"
            android:letterSpacing="0.12"
            android:gravity="center" />

        <TextView
            android:id="@+id/fullscreenSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="…"
            android:textColor="#88A0C0"
            android:textSize="12sp"
            android:gravity="center"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="20dp"
        android:paddingBottom="36dp">

        <TextView
            android:id="@+id/btnExplodeAgain"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/bg_input"
            android:text="💥 Explosion"
            android:textColor="#E8ECF4"
            android:textSize="13sp"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/btnRefreshFullscreenGraph"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/bg_input"
            android:text="↻ Rafraîchir"
            android:textColor="#E8ECF4"
            android:textSize="13sp"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/btnCloseGraph"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/bg_mic_button"
            android:text="Fermer"
            android:textColor="#0A0E16"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>

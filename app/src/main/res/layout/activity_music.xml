<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎵 Musique"
            android:textColor="@color/cyan_accent"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Lecture des fichiers audio stockés sur le téléphone. Pour la musique diffusée sur des enceintes connectées, utilise le panneau 🏠 Home Assistant (media_player)."
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:layout_marginBottom="14dp" />

        <EditText
            android:id="@+id/musicSearchInput"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="@drawable/bg_input"
            android:hint="Titre ou artiste (ex: Daft Punk)"
            android:textColorHint="@color/text_secondary"
            android:textColor="@color/text_primary"
            android:padding="12dp"
            android:layout_marginBottom="10dp" />

        <TextView
            android:id="@+id/btnMusicPlay"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="@drawable/bg_mic_button"
            android:gravity="center"
            android:text="▶️ Lire"
            android:textColor="@color/background_dark"
            android:textStyle="bold"
            android:textSize="13sp"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/btnMusicPause"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input"
                android:gravity="center"
                android:text="⏸️ Pause"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/btnMusicResume"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input"
                android:gravity="center"
                android:text="▶️ Reprendre"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/btnMusicNext"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input"
                android:gravity="center"
                android:text="⏭️ Suivant"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/btnMusicStop"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input"
                android:gravity="center"
                android:text="⏹️ Stop"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/musicOutputText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_input"
            android:padding="14dp"
            android:text="Recherche un titre ou un artiste pour commencer."
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:lineSpacingExtra="3dp" />

    </LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ── Contenu principal (chat) ─────────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/background_dark"
        android:padding="12dp">

        <LinearLayout
            android:id="@+id/headerRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/menuButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="8dp"
                android:text="☰"
                android:textSize="20sp"
                android:textColor="@color/cyan_accent"
                android:gravity="center"
                android:background="@drawable/bg_icon_button" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/titleText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="J A R V I S"
                    android:textColor="@color/cyan_accent"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.2"
                    android:paddingTop="8dp" />

                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="● en veille"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:fontFamily="monospace" />

            </LinearLayout>

            <!-- Un seul bouton vers le menu complet (domotique, création IA, Obsidian,
                 contrôle téléphone, GitHub, réglages...) — remplace les 3 icônes séparées
                 et peu explicites d'avant pour un header plus propre et plus lisible. -->
            <TextView
                android:id="@+id/hubButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="8dp"
                android:text="▤"
                android:textSize="20sp"
                android:gravity="center"
                android:background="@drawable/bg_icon_button" />

            <TextView
                android:id="@+id/settingsButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:text="⚙"
                android:textSize="22sp"
                android:textColor="@color/cyan_accent"
                android:gravity="center"
                android:background="@drawable/bg_icon_button" />

        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="12dp"
            android:clipToPadding="false"
            android:paddingBottom="8dp" />

        <LinearLayout
            android:id="@+id/pendingImageBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone"
            android:paddingTop="8dp">

            <ImageView
                android:id="@+id/pendingImageThumbnail"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/removePendingImageButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:padding="8dp"
                android:text="✕ retirer la photo"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:background="?attr/selectableItemBackground" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/inputBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="8dp">

            <TextView
                android:id="@+id/photoButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="6dp"
                android:text="📷"
                android:textSize="18sp"
                android:gravity="center"
                android:background="@drawable/bg_input" />

            <EditText
                android:id="@+id/messageInput"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:hint="@string/hint_message"
                android:textColorHint="@color/text_secondary"
                android:textColor="@color/text_primary"
                android:maxLines="3"
                android:inputType="textMultiLine|textCapSentences" />

            <TextView
                android:id="@+id/micButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:text="🎤"
                android:textSize="20sp"
                android:gravity="center"
                android:background="@drawable/bg_mic_button" />

            <TextView
                android:id="@+id/sendButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:text="➤"
                android:textSize="18sp"
                android:textColor="@color/background_dark"
                android:gravity="center"
                android:background="@drawable/bg_mic_button" />

        </LinearLayout>

        <include
            layout="@layout/bottom_nav_bar"
            android:layout_marginStart="-12dp"
            android:layout_marginEnd="-12dp"
            android:layout_marginBottom="-12dp"
            android:layout_marginTop="8dp" />

    </LinearLayout>

    <!-- ── Tiroir latéral rétractable : historique des conversations ──────────── -->
    <LinearLayout
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="@color/surface_dark"
        android:padding="16dp"
        android:elevation="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Conversations"
            android:textColor="@color/cyan_accent"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/newConversationButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="＋ Nouvelle conversation"
            android:textColor="@color/background_dark"
            android:textStyle="bold"
            android:gravity="center"
            android:background="@drawable/bg_mic_button"
            android:layout_marginBottom="16dp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/conversationListContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </ScrollView>

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>

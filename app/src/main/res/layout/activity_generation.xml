<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎨 Génération IA"
            android:textColor="@color/cyan_accent"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <!-- Carte de progression : visible seulement s'il y a une génération en cours
             (lancée depuis cet écran OU depuis le chat), y compris en arrière-plan. -->
        <LinearLayout
            android:id="@+id/activeGenCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_input"
            android:padding="12dp"
            android:visibility="gone"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/activeGenLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="⏳ Génération en cours..."
                android:textColor="@color/cyan_accent"
                android:textStyle="bold"
                android:textSize="12sp"
                android:layout_marginBottom="8dp" />

            <ProgressBar
                android:id="@+id/activeGenProgressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:indeterminate="true" />

        </LinearLayout>

        <!-- IMAGE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🖼️ Image"
            android:textColor="@color/cyan_accent"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/imagePromptInput"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="@drawable/bg_input"
            android:hint="Décris l'image à générer"
            android:textColorHint="@color/text_secondary"
            android:textColor="@color/text_primary"
            android:padding="12dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/btnGenImage"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_mic_button"
            android:gravity="center"
            android:text="✨ Générer l'image"
            android:textColor="@color/background_dark"
            android:textStyle="bold"
            android:textSize="12sp"
            android:layout_marginBottom="8dp" />

        <ImageView
            android:id="@+id/generatedImageView"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:visibility="gone"
            android:scaleType="centerCrop"
            android:background="@drawable/bg_input"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/imageOutputText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_input"
            android:padding="12dp"
            android:text="En attente."
            android:textColor="@color/text_primary"
            android:textSize="11sp"
            android:layout_marginBottom="20dp" />

        <!-- VIDEO -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎬 Vidéo (via Replicate)"
            android:textColor="@color/cyan_accent"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/replicateTokenInput"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_input"
            android:hint="Jeton API Replicate (replicate.com/account/api-tokens)"
            android:textColorHint="@color/text_secondary"
            android:textColor="@color/text_primary"
            android:inputType="textPassword"
            android:padding="10dp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/videoPromptInput"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="@drawable/bg_input"
            android:hint="Décris la vidéo à générer"
            android:textColorHint="@color/text_secondary"
            android:textColor="@color/text_primary"
            android:padding="12dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/btnGenVideo"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_mic_button"
            android:gravity="center"
            android:text="✨ Générer la vidéo (~1-3 min)"
            android:textColor="@color/background_dark"
            android:textStyle="bold"
            android:textSize="12sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/videoOutputText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_input"
            android:padding="12dp"
            android:text="En attente."
            android:textColor="@color/text_primary"
            android:textSize="11sp"
            android:layout_marginBottom="20dp" />

        <!-- SITE WEB -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🌐 Site web"
            android:textColor="@color/cyan_accent"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/websitePromptInput"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="@drawable/bg_input"
            android:hint="Décris le site web à générer"
            android:textColorHint="@color/text_secondary"
            android:textColor="@color/text_primary"
            android:padding="12dp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/btnGenWebsite"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/bg_mic_button"
                android:gravity="center"
                android:text="✨ Générer"
                android:textColor="@color/background_dark"
                android:textStyle="bold"
                android:textSize="12sp"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/btnOpenWebsite"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input"
                android:gravity="center"
                android:text="🌐 Ouvrir le dernier"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/websiteOutputText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_input"
            android:padding="12dp"
            android:text="En attente."
            android:textColor="@color/text_primary"
            android:textSize="11sp"
            android:layout_marginBottom="20dp" />

        <!-- HISTORIQUE -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🕓 Historique des générations"
                android:textColor="@color/cyan_accent"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnRefreshHistory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔄"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/btnViewLastImage"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input"
                android:gravity="center"
                android:text="🖼️ Dernière image"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/btnViewLastVideo"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input"
                android:gravity="center"
                android:text="▶️ Dernière vidéo"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/historyEmptyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_input"
            android:padding="12dp"
            android:text="Aucune génération pour l'instant."
            android:textColor="@color/text_primary"
            android:textSize="11sp"
            android:visibility="gone" />

        <!-- Galerie : rempli dynamiquement par GenerationActivity, une carte cliquable
             par génération (image/vidéo/site), pour afficher ou modifier chaque élément. -->
        <LinearLayout
            android:id="@+id/historyContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>
</ScrollView>

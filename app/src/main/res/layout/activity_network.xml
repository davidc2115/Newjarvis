<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📡 Réseau local"
            android:textColor="@color/cyan_accent"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Découvre les appareils connectés sur le même Wi-Fi (PC, TV, imprimante, box, caméras...) et réveille-les à distance (Wake-on-LAN)."
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:layout_marginBottom="14dp" />

        <TextView
            android:id="@+id/btnNetworkScan"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="@drawable/bg_mic_button"
            android:gravity="center"
            android:text="🔍 Scanner le réseau"
            android:textColor="@color/background_dark"
            android:textStyle="bold"
            android:textSize="13sp"
            android:layout_marginBottom="14dp" />

        <TextView
            android:id="@+id/networkEmptyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_input"
            android:padding="14dp"
            android:text="Touche « Scanner le réseau » pour lister les appareils connectés à ton Wi-Fi. Touche ensuite un appareil trouvé (imprimante, box, NAS...) pour ouvrir son interface web, le réveiller ou le retester."
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:lineSpacingExtra="3dp"
            android:layout_marginBottom="20dp" />

        <!-- Rempli dynamiquement par NetworkActivity après un scan : une carte cliquable
             par appareil détecté, avec accès direct à son interface web/Wake-on-LAN. -->
        <LinearLayout
            android:id="@+id/networkDevicesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="20dp" />

        <!-- Wake-on-LAN -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚡ Réveiller un appareil (Wake-on-LAN)"
            android:textColor="@color/cyan_accent"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/wolNameInput"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_input"
            android:hint="Nom (ex: PC Bureau)"
            android:textColorHint="@color/text_secondary"
            android:textColor="@color/text_primary"
            android:padding="10dp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/wolMacInput"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_input"
            android:hint="Adresse MAC (AA:BB:CC:DD:EE:FF)"
            android:textColorHint="@color/text_secondary"
            android:textColor="@color/text_primary"
            android:padding="10dp"
            android:layout_marginBottom="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/btnWolSave"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input"
                android:gravity="center"
                android:text="💾 Enregistrer"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/btnWolWake"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:background="@drawable/bg_mic_button"
                android:gravity="center"
                android:text="⚡ Réveiller"
                android:textColor="@color/background_dark"
                android:textStyle="bold"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📋 Appareils enregistrés"
            android:textColor="@color/cyan_accent"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/savedDevicesText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_input"
            android:padding="14dp"
            android:text="Aucun appareil enregistré."
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:lineSpacingExtra="3dp" />

    </LinearLayout>
</ScrollView>

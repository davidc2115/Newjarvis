<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📱 Dashboard de Contrôle JARVIS"
            android:textColor="@color/cyan_accent"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/permissionsReportText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_input"
            android:padding="16dp"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:lineSpacingExtra="3dp"
            android:layout_marginBottom="20dp" />

        <!-- Boutons de demande de permissions individuelles -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/btnRequestSms"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="💬 Demander SMS"
                android:textColor="@color/cyan_accent"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/bg_input" />

            <TextView
                android:id="@+id/btnRequestContacts"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="👤 Demander Contacts"
                android:textColor="@color/cyan_accent"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/bg_input" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnGrantPermissions"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="🔐 DEMANDER TOUTES LES PERMISSIONS"
            android:textColor="@color/background_dark"
            android:textStyle="bold"
            android:gravity="center"
            android:background="@drawable/bg_mic_button"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/btnAppDetailsSettings"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="⚙️ AUTORISATIONS MANUELLES (Si refusé ou Paramètres restreints)"
            android:textColor="@color/cyan_accent"
            android:textStyle="bold"
            android:gravity="center"
            android:background="@drawable/bg_input"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/btnNotifAccess"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="🔔 ACCÈS AUX NOTIFICATIONS"
            android:textColor="@color/cyan_accent"
            android:textStyle="bold"
            android:gravity="center"
            android:background="@drawable/bg_input"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/btnStorageAccess"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="📁 ACCÈS COMPLET AU STOCKAGE"
            android:textColor="@color/cyan_accent"
            android:textStyle="bold"
            android:gravity="center"
            android:background="@drawable/bg_input"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/btnEmailConfig"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="📧 CONFIGURATION EMAIL IMAP / SMTP"
            android:textColor="@color/cyan_accent"
            android:textStyle="bold"
            android:gravity="center"
            android:background="@drawable/bg_input"
            android:layout_marginBottom="24dp" />

        <!-- Output display -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Résultat d'action / Test rapide :"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/actionOutputText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="100dp"
            android:background="@drawable/bg_input"
            android:padding="16dp"
            android:text="Sélectionnez une action ci-dessous..."
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:layout_marginBottom="20dp" />

        <!-- Grid of quick action buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/btnRecentCalls"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="📞 Appels récents"
                android:textSize="12sp"
                android:gravity="center"
                android:background="@drawable/bg_input"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/btnReadSms"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="💬 SMS récents"
                android:textSize="12sp"
                android:gravity="center"
                android:background="@drawable/bg_input"
                android:textColor="@color/text_primary" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/btnReadEmails"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="📧 Emails IMAP"
                android:textSize="12sp"
                android:gravity="center"
                android:background="@drawable/bg_input"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/btnReadEvents"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="📅 Agenda"
                android:textSize="12sp"
                android:gravity="center"
                android:background="@drawable/bg_input"
                android:textColor="@color/text_primary" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/btnGetLocation"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="📍 Géolocalisation"
                android:textSize="12sp"
                android:gravity="center"
                android:background="@drawable/bg_input"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/btnGetNotifs"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="🔔 Notifications"
                android:textSize="12sp"
                android:gravity="center"
                android:background="@drawable/bg_input"
                android:textColor="@color/text_primary" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>

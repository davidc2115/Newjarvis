<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_app_gradient">

    <RelativeLayout
        android:id="@+id/graphTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <ImageButton
            android:id="@+id/graphBackButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            android:background="@drawable/bg_icon_button"
            android:src="@drawable/ic_back"
            android:contentDescription="@string/vault_graph_title"
            android:padding="8dp" />

        <TextView
            android:id="@+id/graphTitleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="@string/vault_graph_title"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

    </RelativeLayout>

    <TextView
        android:id="@+id/graphEmptyText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/vault_no_vault_message"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:padding="24dp"
        android:visibility="gone" />

    <com.jarvis.assistant.VaultGraphView
        android:id="@+id/graphView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>

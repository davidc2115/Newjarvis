<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🏠 Home Assistant"
            android:textColor="@color/cyan_accent"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Connecte JARVIS à ton serveur Home Assistant pour contrôler lumières, prises, volets, chauffage, serrures... Crée un jeton d'accès à long terme dans HA (Profil → Sécurité) et colle-le ci-dessous."
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:layout_marginBottom="14dp" />

        <!-- Configuration -->
        <EditText
            android:id="@+id/haUrlInput"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_input"
            android:hint="URL locale Home Assistant (ex: http://192.168.1.50:8123)"
            android:textColorHint="@color/text_secondary"
            android:textColor="@color/text_primary"
            android:inputType="textUri"
            android:padding="12dp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/haRemoteUrlInput"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_input"
            android:hint="URL distante (optionnel, ex: Nabu Casa) — pour piloter hors Wi-Fi"
            android:textColorHint="@color/text_secondary"
            android:textColor="@color/text_primary"
            android:inputType="textUri"
            android:padding="12dp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/haTokenInput"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_input"
            android:hint="Jeton d'accès à long terme"
            android:textColorHint="@color/text_secondary"
            android:textColor="@color/text_primary"
            android:inputType="textPassword"
            android:padding="12dp"
            android:layout_marginBottom="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/btnHaSave"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/bg_mic_button"
                android:gravity="center"
                android:text="💾 Enregistrer"
                android:textColor="@color/background_dark"
                android:textStyle="bold"
                android:textSize="12sp"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/btnHaRefresh"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input"
                android:gravity="center"
                android:text="🔄 Nouveau scan"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Recherche -->
        <EditText
            android:id="@+id/haSearchInput"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_input"
            android:hint="Rechercher un appareil (ex: salon, lumière)"
            android:textColorHint="@color/text_secondary"
            android:textColor="@color/text_primary"
            android:padding="10dp"
            android:layout_marginBottom="10dp" />

        <!-- Actions rapides sur l'appareil trouvé -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/btnHaTurnOn"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input"
                android:gravity="center"
                android:text="✅ Allumer"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/btnHaTurnOff"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input"
                android:gravity="center"
                android:text="⛔ Éteindre"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/btnHaToggle"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input"
                android:gravity="center"
                android:text="🔀 Basculer"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Renommer / Supprimer -->
        <EditText
            android:id="@+id/haRenameInput"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_input"
            android:hint="Nouveau nom (pour Renommer)"
            android:textColorHint="@color/text_secondary"
            android:textColor="@color/text_primary"
            android:padding="10dp"
            android:layout_marginBottom="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/btnHaRename"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input"
                android:gravity="center"
                android:text="✏️ Renommer"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/btnHaDelete"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input"
                android:gravity="center"
                android:text="🗑️ Supprimer"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Sortie -->
        <TextView
            android:id="@+id/haOutputText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_input"
            android:padding="14dp"
            android:text="Renseigne l'URL et le jeton, puis touche Enregistrer."
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:lineSpacingExtra="3dp" />

    </LinearLayout>
</ScrollView>

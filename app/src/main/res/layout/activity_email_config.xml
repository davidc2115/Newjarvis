<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Titre -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🌐 Connexion Compte Google"
            android:textColor="@color/cyan_accent"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="20dp"
            android:text="Connectez votre compte Google pour lire et envoyer vos e-mails directement depuis JARVIS."
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <!-- ══════════════════════════════════════════════════════════════════ -->
        <!-- SECTION 1 : Comptes Google détectés sur l'appareil (1 clic)       -->
        <!-- ══════════════════════════════════════════════════════════════════ -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📱 Connexion rapide — 1 clic"
            android:textColor="@color/cyan_accent"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:id="@+id/deviceAccountsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="8dp" />

        <!-- ══════════════════════════════════════════════════════════════════ -->
        <!-- SECTION 2 : Connexion Web Google (ouvre le navigateur)            -->
        <!-- ══════════════════════════════════════════════════════════════════ -->

        <TextView
            android:id="@+id/btnOpenWebGoogleLogin"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_mic_button"
            android:gravity="center"
            android:text="🌐 OUVRIR LA PAGE GOOGLE DANS LE NAVIGATEUR"
            android:textColor="@color/background_dark"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp" />

        <!-- ══════════════════════════════════════════════════════════════════ -->
        <!-- SECTION 3 : Connexion par App Password (16 lettres)               -->
        <!-- ══════════════════════════════════════════════════════════════════ -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔑 Connexion par mot de passe d'application"
            android:textColor="@color/cyan_accent"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="Nécessite un mot de passe d'app Google 16 lettres (Sécurité → Mots de passe des applications)."
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Adresse Gmail :"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/emailInput"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_input"
            android:hint="exemple@gmail.com"
            android:inputType="textEmailAddress"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mot de passe d'application (16 lettres sans espaces) :"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/passwordInput"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_input"
            android:hint="abcd efgh ijkl mnop"
            android:inputType="textPassword"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary" />

        <TextView
            android:id="@+id/btnConnectGoogle"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_input"
            android:gravity="center"
            android:text="✅ CONNECTER ET TESTER"
            android:textColor="@color/cyan_accent"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/testResultText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="start"
            android:textColor="@color/cyan_accent"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnOpenGooglePassGuide"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="🔑 Générer un Mot de Passe d'Application Google →"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="24dp" />

        <!-- ══════════════════════════════════════════════════════════════════ -->
        <!-- SECTION 4 : Comptes déjà configurés dans JARVIS                  -->
        <!-- ══════════════════════════════════════════════════════════════════ -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="📋 Comptes Configurés dans JARVIS"
            android:textColor="@color/cyan_accent"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/accountsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical" />

    </LinearLayout>
</ScrollView>

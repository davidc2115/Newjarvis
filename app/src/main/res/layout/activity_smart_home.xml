<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🏠 Maison connectée"
            android:textColor="@color/cyan_accent"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Domotique, appareils réseau, musique et création IA — tout ce que JARVIS peut contrôler autour de toi."
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:layout_marginBottom="20dp" />

        <TextView
            android:id="@+id/btnOpenHomeAssistant"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_input"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="🏠  Home Assistant — lumières, prises, volets, chauffage..."
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:layout_marginBottom="10dp" />

        <TextView
            android:id="@+id/btnOpenNetwork"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_input"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="📡  Réseau local — scanner et réveiller les appareils Wi-Fi"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:layout_marginBottom="10dp" />

        <TextView
            android:id="@+id/btnOpenMusic"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_input"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="🎵  Musique — lecture des fichiers audio du téléphone"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:layout_marginBottom="10dp" />

        <TextView
            android:id="@+id/btnOpenGeneration"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_input"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="🎨  Génération IA — image, vidéo, site web"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

    </LinearLayout>
</ScrollView>

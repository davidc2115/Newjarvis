<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_dark">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚙ Paramètres JARVIS"
            android:textColor="@color/cyan_accent"
            android:textSize="20sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Configure ton assistant"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:layout_marginBottom="16dp" />

        <!-- Sous-navigation : Dashboard / Obsidian / Paramètres -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">

            <TextView
                android:id="@+id/subNavDashboard"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="📊 Dashboard"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/bg_input"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/subNavObsidian"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:text="🧠 Obsidian"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/bg_input"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/subNavParams"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="⚙ Paramètres"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/bg_nav_active"
                android:textColor="@color/cyan_accent" />

        </LinearLayout>

        <!-- Style Orbe -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Couleur du mode vocal"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <!-- Sélecteur défilant (carrousel) : glisser horizontalement pour parcourir
             les couleurs, la sélection s'agrandit et prend un contour blanc. -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/colorCarousel"
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:orientation="horizontal"
            android:clipToPadding="false"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Style de l'orbe vocale"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <!-- Sélecteur défilant : chaque carte montre un VRAI aperçu animé du style
             (mini orbe live), pas juste un nom — glisse pour comparer avant de choisir. -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/orbStyleCarousel"
            android:layout_width="match_parent"
            android:layout_height="130dp"
            android:orientation="horizontal"
            android:clipToPadding="false"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp" />

        <!-- Provider actif -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fournisseur IA actif"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <Spinner
            android:id="@+id/providerSpinner"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_input"
            android:popupBackground="@color/surface_dark"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp" />

        <!-- Onglets -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tabCloud"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="☁ Config"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/bg_input"
                android:textColor="@color/cyan_accent" />

            <TextView
                android:id="@+id/tabApiKeys"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:text="🔑 Clés"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/bg_input"
                android:textColor="@color/cyan_accent"
                android:alpha="0.45" />

            <TextView
                android:id="@+id/tabLocal"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:text="🧠 Local"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/bg_input"
                android:textColor="@color/cyan_accent"
                android:alpha="0.45" />

            <TextView
                android:id="@+id/tabSystem"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="📡 Box/Écoute"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/bg_input"
                android:textColor="@color/cyan_accent"
                android:alpha="0.45" />

        </LinearLayout>

        <!-- Onglet CLOUD -->
        <LinearLayout
            android:id="@+id/panelCloud"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible">

            <TextView
                android:id="@+id/autoInfoText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🤖 Mode Automatique : JARVIS essaie Groq → Claude → ChatGPT → Gemini → Mistral → DeepSeek → Perplexity dans cet ordre."
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:visibility="gone"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:id="@+id/advancedConfigSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="URL de l'API"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/baseUrlInput"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:inputType="textUri"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nom du modèle"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/modelInput"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Clé API du fournisseur actif"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/apiKeyInput"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/text_primary"
                android:hint="sk-..."
                android:textColorHint="@color/text_secondary"
                android:inputType="textPassword"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/saveButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="ENREGISTRER"
                android:textColor="@color/background_dark"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/bg_mic_button"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="8dp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Onglet CLÉS API -->
        <LinearLayout
            android:id="@+id/panelApiKeys"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/apiKeysContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Intégrations distantes (voir FirecrawlController/GlifController). Perplexity
                 n'a pas de champ ici : sa clé est déjà dans la liste dynamique ci-dessus
                 (apiKeysContainer, Provider.PERPLEXITY), pas de doublon. -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔥 Firecrawl (lecture de pages web)"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/firecrawlKeyInput"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/text_primary"
                android:hint="Clé Firecrawl (fc-...)"
                android:textColorHint="@color/text_secondary"
                android:inputType="textPassword"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/glifTokenLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🧩 Glif (workflows IA glif.app)"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/glifTokenInput"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/text_primary"
                android:hint="Jeton Glif (glif.app/settings/api-tokens)"
                android:textColorHint="@color/text_secondary"
                android:inputType="textPassword"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/saveApiKeysButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="ENREGISTRER TOUTES LES CLÉS"
                android:textColor="@color/background_dark"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/bg_mic_button"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp" />


        </LinearLayout>

        <!-- Onglet SYSTÈME (Codage GitHub + Écoute permanente) -->
        <LinearLayout
            android:id="@+id/panelSystem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/text_secondary"
                android:alpha="0.2"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎙️ Écoute permanente"
                android:textColor="@color/cyan_accent"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="JARVIS écoute en arrière-plan et se déclenche dès que tu dis le mot-clé. ⚠️ Consomme plus de batterie qu'une utilisation normale, et nécessite internet. Sur certains téléphones (Xiaomi/MIUI notamment), il faut aussi autoriser le « démarrage automatique » de JARVIS dans les paramètres batterie du système, sinon Android coupera l'écoute au bout de quelques minutes."
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:lineSpacingExtra="3dp"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mot-clé d'activation"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/wakeWordInput"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/text_primary"
                android:hint="jarvis"
                android:textColorHint="@color/text_secondary"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Clé d'accès Picovoice (optionnelle — voir openWakeWord ci-dessous)"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/picovoiceKeyInput"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/text_primary"
                android:hint="clé AccessKey Picovoice"
                android:textColorHint="@color/text_secondary"
                android:inputType="textPassword"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="💡 Laisse ce champ vide si tu veux : sans clé Picovoice, JARVIS utilise automatiquement openWakeWord — un moteur 100% GRATUIT, SANS CLÉ, hors-ligne et à très faible consommation batterie (aucune reconnaissance vocale continue, juste un petit modèle qui reconnaît un mot précis). Avec une clé Picovoice (gratuite sur console.picovoice.ai → AccessKey), JARVIS utilise ce moteur à la place, encore un peu plus économe. \n\n⚠️ Important : ces DEUX moteurs ne reconnaissent que des mots-clés prédéfinis, pas un mot totalement inventé — openWakeWord : « jarvis », « alexa », « mycroft » ; Picovoice : « jarvis », « computer », « alexa », « picovoice », « porcupine », « terminator », « blueberry », « bumblebee », « grapefruit », « grasshopper ». Si tu tapes un autre mot, JARVIS écoutera « Jarvis » à la place et te le signalera dans la notification — c'est le compromis nécessaire pour une écoute permanente qui ne vide pas la batterie."
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:lineSpacingExtra="3dp"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/toggleWakeWordButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="ACTIVER L'ÉCOUTE PERMANENTE"
                android:textColor="@color/background_dark"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/bg_mic_button"
                android:layout_marginBottom="8dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/text_secondary"
                android:alpha="0.2"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="16dp" />

            <!-- Box internet (voir RouterController) — configuration automatique : plus de
                 formulaire manuel. Le fournisseur est détecté via le SSID Wi-Fi lors d'un scan
                 réseau, la Freebox s'appaire directement depuis son écran physique (demande
                 d'autorisation affichée dessus), les autres fournisseurs (Livebox/SFR Box/Bbox,
                 pas d'écran de confirmation possible) demandent leur mot de passe admin
                 directement en conversation avec JARVIS. Section en lecture seule. -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📦 Box Internet"
                android:textColor="@color/cyan_accent"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pour une Freebox : touche le bouton ci-dessous, une demande d'autorisation apparaîtra directement sur l'écran de la Freebox (valide-la dans les ~90 secondes). Pour Livebox, SFR Box ou Bbox (pas d'écran de confirmation possible) : dis simplement à JARVIS quel fournisseur tu utilises, il te demandera le mot de passe admin en conversation."
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:lineSpacingExtra="3dp"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/boxStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ℹ️ Aucune box configurée pour l'instant."
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/rescanBoxButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="🔌 APPAIRER MA FREEBOX"
                android:textColor="@color/background_dark"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/bg_mic_button"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="💡 Une fois la box détectée/configurée, demande à JARVIS : « état de ma box », « quels appareils sont connectés », « éteins le Wi-Fi de la box », « redémarre la box ». Pour la domotique Freebox Home (Delta/Pop), reste disponible séparément une fois la Freebox appairée."
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:lineSpacingExtra="3dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/text_secondary"
                android:alpha="0.2"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="16dp" />

            <!-- Journal de diagnostics (voir DiagnosticsLog) — échecs réels de la cascade IA
                 texte/image/commandes, horodatés. JARVIS n'a AUCUN accès distant au téléphone :
                 ce bouton est la façon honnête de consulter ce qui s'est réellement passé, sans
                 avoir à demander en conversation. Peut aussi être demandé directement à JARVIS
                 (« montre-moi les derniers logs »). -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🩺 Journal de diagnostics"
                android:textColor="@color/cyan_accent"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Historique local des derniers échecs réels (ex: « Toutes les IA ont échoué »), avec horodatage et détail par fournisseur — utile pour diagnostiquer un souci sans avoir à se souvenir du message d'erreur exact."
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:lineSpacingExtra="3dp"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/viewDebugLogsButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="📋 VOIR / COPIER LE JOURNAL"
                android:textColor="@color/cyan_accent"
                android:textSize="12sp"
                android:gravity="center"
                android:background="@drawable/bg_input"
                android:layout_marginBottom="16dp" />

        </LinearLayout>


        <!-- Onglet LOCAL (Modèles IA téléchargés sur le téléphone) -->
        <LinearLayout
            android:id="@+id/panelLocal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- IA locale RÉSEAU (Ollama sur PC/NAS/Freebox), à ne pas confondre avec les
                 modèles EMBARQUÉS plus bas (exécutés directement sur le téléphone). BUG RÉEL
                 CORRIGÉ : auparavant, seul le sélecteur générique Réglages → Cloud permettait
                 de "configurer" Ollama, mais la valeur éditée n'était jamais réellement relue
                 par ApiClient (toujours l'IP d'exemple codée en dur) — cette section dédiée,
                 avec ses propres champs réellement utilisés, corrige ça et permet en plus
                 l'essai automatique en mode "Automatique". -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🖥️ IA locale réseau (Ollama — PC, NAS, Freebox...)"
                android:textColor="@color/cyan_accent"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Si tu fais tourner Ollama sur un ordinateur, un NAS ou ta Freebox (Docker), indique son adresse ici pour que JARVIS l'utilise — gratuit, illimité, et tes données restent sur ton réseau. Doit être sur le MÊME réseau Wi-Fi que ce téléphone."
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:lineSpacingExtra="3dp"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <EditText
                    android:id="@+id/ollamaHostInput"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="3"
                    android:background="@drawable/bg_input"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="@color/text_primary"
                    android:hint="ex: mafreebox.freebox.fr ou 192.168.1.50"
                    android:textColorHint="@color/text_secondary"
                    android:inputType="textUri"
                    android:layout_marginEnd="8dp" />

                <EditText
                    android:id="@+id/ollamaPortInput"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColor="@color/text_primary"
                    android:hint="Port"
                    android:textColorHint="@color/text_secondary"
                    android:inputType="number"
                    android:text="11434" />

            </LinearLayout>

            <EditText
                android:id="@+id/ollamaModelInput"
                android:layout_width="match_parent"
                android:layout_height="48dp"

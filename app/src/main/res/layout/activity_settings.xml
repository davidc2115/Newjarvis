<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_dark">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚙ Paramètres JARVIS"
            android:textColor="@color/cyan_accent"
            android:textSize="20sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Configure ton assistant"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:layout_marginBottom="16dp" />

        <!-- Sous-navigation : Dashboard / Obsidian / Paramètres -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">

            <TextView
                android:id="@+id/subNavDashboard"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="📊 Dashboard"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/bg_input"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/subNavObsidian"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:text="🧠 Obsidian"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/bg_input"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/subNavParams"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="⚙ Paramètres"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/bg_nav_active"
                android:textColor="@color/cyan_accent" />

        </LinearLayout>

        <!-- Style Orbe -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Couleur du mode vocal"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <!-- Sélecteur défilant (carrousel) : glisser horizontalement pour parcourir
             les couleurs, la sélection s'agrandit et prend un contour blanc. -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/colorCarousel"
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:orientation="horizontal"
            android:clipToPadding="false"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Style de l'orbe vocale"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <!-- Sélecteur défilant : chaque carte montre un VRAI aperçu animé du style
             (mini orbe live), pas juste un nom — glisse pour comparer avant de choisir. -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/orbStyleCarousel"
            android:layout_width="match_parent"
            android:layout_height="130dp"
            android:orientation="horizontal"
            android:clipToPadding="false"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp" />

        <!-- Provider actif -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fournisseur IA actif"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <Spinner
            android:id="@+id/providerSpinner"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_input"
            android:popupBackground="@color/surface_dark"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp" />

        <!-- Onglets -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tabCloud"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="☁ Config"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/bg_input"
                android:textColor="@color/cyan_accent" />

            <TextView
                android:id="@+id/tabApiKeys"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:text="🔑 Clés"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/bg_input"
                android:textColor="@color/cyan_accent"
                android:alpha="0.45" />

            <TextView
                android:id="@+id/tabLocal"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:text="🧠 Local"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/bg_input"
                android:textColor="@color/cyan_accent"
                android:alpha="0.45" />

            <TextView
                android:id="@+id/tabSystem"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="🎙️ Écoute"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/bg_input"
                android:textColor="@color/cyan_accent"
                android:alpha="0.45" />

        </LinearLayout>

        <!-- Onglet CLOUD -->
        <LinearLayout
            android:id="@+id/panelCloud"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible">

            <TextView
                android:id="@+id/autoInfoText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🤖 Mode Automatique : JARVIS essaie Groq → Claude → ChatGPT → Gemini → Mistral → DeepSeek → Perplexity dans cet ordre."
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:visibility="gone"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:id="@+id/advancedConfigSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="URL de l'API"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/baseUrlInput"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:inputType="textUri"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nom du modèle"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/modelInput"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Clé API du fournisseur actif"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/apiKeyInput"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/text_primary"
                android:hint="sk-..."
                android:textColorHint="@color/text_secondary"
                android:inputType="textPassword"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/saveButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="ENREGISTRER"
                android:textColor="@color/background_dark"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/bg_mic_button"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="8dp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Onglet CLÉS API -->
        <LinearLayout
            android:id="@+id/panelApiKeys"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/apiKeysContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/saveApiKeysButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="ENREGISTRER TOUTES LES CLÉS"
                android:textColor="@color/background_dark"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/bg_mic_button"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp" />


        </LinearLayout>

        <!-- Onglet SYSTÈME (Codage GitHub + Écoute permanente) -->
        <LinearLayout
            android:id="@+id/panelSystem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/text_secondary"
                android:alpha="0.2"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎙️ Écoute permanente"
                android:textColor="@color/cyan_accent"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="JARVIS écoute en arrière-plan et se déclenche dès que tu dis le mot-clé. ⚠️ Consomme plus de batterie qu'une utilisation normale, et nécessite internet. Sur certains téléphones (Xiaomi/MIUI notamment), il faut aussi autoriser le « démarrage automatique » de JARVIS dans les paramètres batterie du système, sinon Android coupera l'écoute au bout de quelques minutes."
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:lineSpacingExtra="3dp"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mot-clé d'activation"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/wakeWordInput"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/text_primary"
                android:hint="jarvis"
                android:textColorHint="@color/text_secondary"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Clé d'accès Picovoice (optionnelle — voir openWakeWord ci-dessous)"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/picovoiceKeyInput"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/text_primary"
                android:hint="clé AccessKey Picovoice"
                android:textColorHint="@color/text_secondary"
                android:inputType="textPassword"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="💡 Laisse ce champ vide si tu veux : sans clé Picovoice, JARVIS utilise automatiquement openWakeWord — un moteur 100% GRATUIT, SANS CLÉ, hors-ligne et à très faible consommation batterie (aucune reconnaissance vocale continue, juste un petit modèle qui reconnaît un mot précis). Avec une clé Picovoice (gratuite sur console.picovoice.ai → AccessKey), JARVIS utilise ce moteur à la place, encore un peu plus économe. \n\n⚠️ Important : ces DEUX moteurs ne reconnaissent que des mots-clés prédéfinis, pas un mot totalement inventé — openWakeWord : « jarvis », « alexa », « mycroft » ; Picovoice : « jarvis », « computer », « alexa », « picovoice », « porcupine », « terminator », « blueberry », « bumblebee », « grapefruit », « grasshopper ». Si tu tapes un autre mot, JARVIS écoutera « Jarvis » à la place et te le signalera dans la notification — c'est le compromis nécessaire pour une écoute permanente qui ne vide pas la batterie."
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:lineSpacingExtra="3dp"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/toggleWakeWordButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="ACTIVER L'ÉCOUTE PERMANENTE"
                android:textColor="@color/background_dark"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/bg_mic_button"
                android:layout_marginBottom="8dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/text_secondary"
                android:alpha="0.2"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="16dp" />

            <!-- Accès SMB/CIFS générique (voir SmbController) — demandé explicitement, absent
                 des Paramètres jusqu'ici (seule commande chat smb_configure existait). -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🗄️ Partage réseau (SMB)"
                android:textColor="@color/cyan_accent"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Accède au disque dur de ta Freebox (une fois son partage SMB activé dans Freebox OS → Paramètres → Mode disque dur) ou à tout autre NAS/PC partagé. Identifiants = le compte SMB créé côté serveur, PAS ton identifiant Freebox Connect."
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:lineSpacingExtra="3dp"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Adresse du serveur"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/smbHostInput"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/text_primary"
                android:hint="Freebox_Server ou son IP locale"
                android:textColorHint="@color/text_secondary"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Utilisateur SMB (laisser vide = accès anonyme)"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/smbUsernameInput"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/text_primary"
                android:hint="nom d'utilisateur"
                android:textColorHint="@color/text_secondary"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mot de passe SMB"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/smbPasswordInput"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/text_primary"
                android:hint="mot de passe"
                android:textColorHint="@color/text_secondary"
                android:inputType="textPassword"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/saveSmbButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="ENREGISTRER L'ACCÈS SMB"
                android:textColor="@color/background_dark"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/bg_mic_button"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="💡 Une fois enregistré, demande directement à JARVIS dans le chat : « liste mon partage Freebox » (smb_list_files) ou « télécharge tel fichier » (smb_download_file)."
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:lineSpacingExtra="3dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/text_secondary"
                android:alpha="0.2"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="16dp" />

            <!-- Freebox OS — accès complet lecture/écriture (réseau, Wi-Fi, domotique
                 Freebox Home), distinct du partage SMB ci-dessus qui ne donne accès
                 qu'aux fichiers. Voir FreeboxController. -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📦 Freebox OS (contrôle total)"
                android:textColor="@color/cyan_accent"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Contrôle réel de ta Freebox (réseau, Wi-Fi, domotique Freebox Home). app_id et app_token s'obtiennent en autorisant une application dans Freebox OS → Paramètres de la Freebox → Gestion des accès → Applications. Ne partage jamais ce jeton : il reste stocké uniquement sur ce téléphone."
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:lineSpacingExtra="3dp"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Adresse de la Freebox"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/freeboxHostInput"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/text_primary"
                android:hint="http://mafreebox.freebox.fr"
                android:textColorHint="@color/text_secondary"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="App ID"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/freeboxAppIdInput"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/text_primary"
                android:hint="ex : fr.jarvis.assistant"
                android:textColorHint="@color/text_secondary"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="App Token"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/freeboxAppTokenInput"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/text_primary"
                android:hint="jeton obtenu lors de l'appairage"
                android:textColorHint="@color/text_secondary"
                android:inputType="textPassword"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/saveFreeboxButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="ENREGISTRER LA FREEBOX"
                android:textColor="@color/background_dark"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/bg_mic_button"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="💡 Une fois enregistré, demande à JARVIS : « état de ma Freebox », « quels appareils sont connectés », « éteins le Wi-Fi de la Freebox », « liste mes appareils domotique », « allume la prise du salon »."
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:lineSpacingExtra="3dp" />
        </LinearLayout>


        <!-- Onglet LOCAL (Modèles IA téléchargés sur le téléphone) -->
        <LinearLayout
            android:id="@+id/panelLocal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Téléchargez un modèle IA directement sur le stockage de votre téléphone pour l'utiliser sans aucune connexion Internet."
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/localModelPathText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input"
                android:padding="12dp"
                android:text="Modèle actif : Aucun"
                android:textColor="@color/cyan_accent"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/deleteLocalModelButton"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:text="🗑️ Supprimer ce modèle du téléphone"
                android:textColor="#FF6B6B"
                android:textSize="11sp"
                android:gravity="center"
                android:background="@drawable/bg_input"
                android:layout_marginBottom="16dp" />

            <!-- Titre section modèles -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📦 Modèles disponibles — cliquez pour télécharger directement sur le téléphone"
                android:textColor="@color/cyan_accent"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp" />

            <!-- Cartes dynamiques générées par SettingsActivity.buildModelCard() -->
            <LinearLayout
                android:id="@+id/modelCardsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="8dp" />

            <!-- Barre de progression téléchargement -->
            <TextView
                android:id="@+id/downloadProgressText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/cyan_accent"
                android:textSize="13sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="12dp" />

            <!-- Jeton HF & Custom -->
            <EditText
                android:id="@+id/hfTokenInput"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/text_primary"
                android:hint="Jeton Hugging Face (optionnel)"
                android:textColorHint="@color/text_secondary"
                android:inputType="textPassword"
                android:layout_marginBottom="12dp" />

            <EditText
                android:id="@+id/customModelUrlInput"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/text_primary"
                android:hint="URL personnalisée (https://...)"
                android:textColorHint="@color/text_secondary"
                android:inputType="textUri"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/downloadCustomButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="⬇ TÉLÉCHARGER CETTE URL"
                android:textColor="@color/cyan_accent"
                android:gravity="center"
                android:background="@drawable/bg_input"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/pickModelButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="📁 CHOISIR UN FICHIER FICHIER SUR LE TÉLÉPHONE"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:gravity="center"
                android:background="@drawable/bg_input"
                android:layout_marginBottom="16dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/text_secondary"
                android:alpha="0.2"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎨 Génération d'image embarquée (Stable Diffusion)"
                android:textColor="@color/cyan_accent"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Génère de vraies images directement sur le téléphone, sans réseau. ⚠️ Sans GPU dédié, compte plusieurs minutes par image sur CPU mobile — c'est la réalité du calcul de diffusion, pas un défaut. Importe un modèle Stable Diffusion (.safetensors, .ckpt ou .gguf, souvent 2 à 4 Go) téléchargé depuis Hugging Face ou Civitai."
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:lineSpacingExtra="3dp"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/sdModelPathText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input"
                android:padding="12dp"
                android:text="Aucun modèle importé"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/deleteSdModelButton"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:text="🗑️ Supprimer ce modèle du téléphone"
                android:textColor="#FF6B6B"
                android:textSize="11sp"
                android:gravity="center"
                android:background="@drawable/bg_input"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/pickSdModelButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="📁 IMPORTER UN MODÈLE STABLE DIFFUSION"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:gravity="center"
                android:background="@drawable/bg_input"
                android:layout_marginBottom="16dp" />

        </LinearLayout>

    </LinearLayout>

    </ScrollView>

    <include layout="@layout/bottom_nav_bar" />

</LinearLayout>

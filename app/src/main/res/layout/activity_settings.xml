<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_dark">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚙ Paramètres JARVIS"
            android:textColor="@color/cyan_accent"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Configure ton assistant"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:layout_marginBottom="16dp" />

        <!-- Sous-navigation : Dashboard / Obsidian / Paramètres -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">

            <TextView
                android:id="@+id/subNavDashboard"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="📊 Dashboard"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/bg_input"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/subNavObsidian"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:text="🧠 Obsidian"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/bg_input"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/subNavParams"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="⚙ Paramètres"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/bg_nav_active"
                android:textColor="@color/cyan_accent" />

        </LinearLayout>

        <!-- Style Orbe -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Couleur du mode vocal"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp">

            <TextView android:id="@+id/colorCyan"   style="@style/ColorSwatch" android:background="#00E5FF" />
            <TextView android:id="@+id/colorRed"    style="@style/ColorSwatch" android:background="#FF3B30" />
            <TextView android:id="@+id/colorBlue"   style="@style/ColorSwatch" android:background="#2979FF" />
            <TextView android:id="@+id/colorPurple" style="@style/ColorSwatch" android:background="#B388FF" />
            <TextView android:id="@+id/colorGold"   style="@style/ColorSwatch" android:background="#FFC400" />
            <TextView android:id="@+id/colorGreen"  style="@style/ColorSwatch" android:background="#00E676" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Style de l'orbe vocale"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:id="@+id/styleOrbPulse"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="Orbe pulsante"
                android:textSize="12sp"
                android:gravity="center"
                android:background="@drawable/bg_input"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/styleOrbNetwork"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="Sphère réseau"
                android:textSize="12sp"
                android:gravity="center"
                android:background="@drawable/bg_input"
                android:textColor="@color/text_primary" />

        </LinearLayout>

        <!-- Provider actif -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fournisseur IA actif"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <Spinner
            android:id="@+id/providerSpinner"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_input"
            android:popupBackground="@color/surface_dark"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp" />

        <!-- Onglets -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tabCloud"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="☁ Config"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/bg_input"
                android:textColor="@color/cyan_accent" />

            <TextView
                android:id="@+id/tabApiKeys"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:text="🔑 Clés"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/bg_input"
                android:textColor="@color/cyan_accent"
                android:alpha="0.45" />

            <TextView
                android:id="@+id/tabLocal"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:text="🧠 Local"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/bg_input"
                android:textColor="@color/cyan_accent"
                android:alpha="0.45" />

            <TextView
                android:id="@+id/tabSystem"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="🎙️ Écoute"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/bg_input"
                android:textColor="@color/cyan_accent"
                android:alpha="0.45" />

        </LinearLayout>

        <!-- Onglet CLOUD -->
        <LinearLayout
            android:id="@+id/panelCloud"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible">

            <TextView
                android:id="@+id/autoInfoText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🤖 Mode Automatique : JARVIS essaie Groq → Claude → ChatGPT → Gemini → Mistral → DeepSeek → Perplexity dans cet ordre."
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:visibility="gone"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:id="@+id/advancedConfigSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="URL de l'API"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/baseUrlInput"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:inputType="textUri"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nom du modèle"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/modelInput"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Clé API du fournisseur actif"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/apiKeyInput"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/text_primary"
                android:hint="sk-..."
                android:textColorHint="@color/text_secondary"
                android:inputType="textPassword"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/saveButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="ENREGISTRER"
                android:textColor="@color/background_dark"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/bg_mic_button"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="8dp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Onglet CLÉS API -->
        <LinearLayout
            android:id="@+id/panelApiKeys"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/apiKeysContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/saveApiKeysButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="ENREGISTRER TOUTES LES CLÉS"
                android:textColor="@color/background_dark"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/bg_mic_button"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp" />


        </LinearLayout>

        <!-- Onglet SYSTÈME (Codage GitHub + Écoute permanente) -->
        <LinearLayout
            android:id="@+id/panelSystem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/text_secondary"
                android:alpha="0.2"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎙️ Écoute permanente"
                android:textColor="@color/cyan_accent"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="JARVIS écoute en arrière-plan et se déclenche dès que tu dis le mot-clé. ⚠️ Consomme plus de batterie qu'une utilisation normale, et nécessite internet. Sur certains téléphones (Xiaomi/MIUI notamment), il faut aussi autoriser le « démarrage automatique » de JARVIS dans les paramètres batterie du système, sinon Android coupera l'écoute au bout de quelques minutes."
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:lineSpacingExtra="3dp"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mot-clé d'activation"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/wakeWordInput"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/text_primary"
                android:hint="jarvis"
                android:textColorHint="@color/text_secondary"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Clé d'accès Picovoice (optionnelle — le mot d'activation fonctionne très bien sans)"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/picovoiceKeyInput"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/text_primary"
                android:hint="clé AccessKey Picovoice"
                android:textColorHint="@color/text_secondary"
                android:inputType="textPassword"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="💡 Laisse ce champ vide si tu veux : sans clé, JARVIS utilise automatiquement la reconnaissance vocale standard d'Android en repli, avec N'IMPORTE QUEL mot d'activation de ton choix (pas juste « jarvis »), et privilégie déjà le mode hors-ligne quand ton téléphone le permet pour économiser batterie/data. Avec une clé Picovoice (gratuite sur console.picovoice.ai → AccessKey), JARVIS bascule sur un moteur encore plus économe en batterie, mais UNIQUEMENT si le mot-clé choisi est l'un des mots intégrés (jarvis, computer, alexa, picovoice...). Aucune des deux solutions ne coûte rien."
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:lineSpacingExtra="3dp"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/toggleWakeWordButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="ACTIVER L'ÉCOUTE PERMANENTE"
                android:textColor="@color/background_dark"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/bg_mic_button"
                android:layout_marginBottom="8dp" />
        </LinearLayout>


        <!-- Onglet LOCAL (Modèles IA téléchargés sur le téléphone) -->
        <LinearLayout
            android:id="@+id/panelLocal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Téléchargez un modèle IA directement sur le stockage de votre téléphone pour l'utiliser sans aucune connexion Internet."
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/localModelPathText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input"
                android:padding="12dp"
                android:text="Modèle actif : Aucun"
                android:textColor="@color/cyan_accent"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/deleteLocalModelButton"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:text="🗑️ Supprimer ce modèle du téléphone"
                android:textColor="#FF6B6B"
                android:textSize="11sp"
                android:gravity="center"
                android:background="@drawable/bg_input"
                android:layout_marginBottom="16dp" />

            <!-- Titre section modèles -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📦 Modèles disponibles — cliquez pour télécharger directement sur le téléphone"
                android:textColor="@color/cyan_accent"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp" />

            <!-- Cartes dynamiques générées par SettingsActivity.buildModelCard() -->
            <LinearLayout
                android:id="@+id/modelCardsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="8dp" />

            <!-- Barre de progression téléchargement -->
            <TextView
                android:id="@+id/downloadProgressText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/cyan_accent"
                android:textSize="13sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="12dp" />

            <!-- Jeton HF & Custom -->
            <EditText
                android:id="@+id/hfTokenInput"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/text_primary"
                android:hint="Jeton Hugging Face (optionnel)"
                android:textColorHint="@color/text_secondary"
                android:inputType="textPassword"
                android:layout_marginBottom="12dp" />

            <EditText
                android:id="@+id/customModelUrlInput"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/text_primary"
                android:hint="URL personnalisée (https://...)"
                android:textColorHint="@color/text_secondary"
                android:inputType="textUri"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/downloadCustomButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="⬇ TÉLÉCHARGER CETTE URL"
                android:textColor="@color/cyan_accent"
                android:gravity="center"
                android:background="@drawable/bg_input"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/pickModelButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="📁 CHOISIR UN FICHIER FICHIER SUR LE TÉLÉPHONE"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:gravity="center"
                android:background="@drawable/bg_input"
                android:layout_marginBottom="16dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/text_secondary"
                android:alpha="0.2"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎨 Génération d'image embarquée (Stable Diffusion)"
                android:textColor="@color/cyan_accent"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Génère de vraies images directement sur le téléphone, sans réseau. ⚠️ Sans GPU dédié, compte plusieurs minutes par image sur CPU mobile — c'est la réalité du calcul de diffusion, pas un défaut. Importe un modèle Stable Diffusion (.safetensors, .ckpt ou .gguf, souvent 2 à 4 Go) téléchargé depuis Hugging Face ou Civitai."
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:lineSpacingExtra="3dp"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/sdModelPathText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input"
                android:padding="12dp"
                android:text="Aucun modèle importé"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/deleteSdModelButton"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:text="🗑️ Supprimer ce modèle du téléphone"
                android:textColor="#FF6B6B"
                android:textSize="11sp"
                android:gravity="center"
                android:background="@drawable/bg_input"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/pickSdModelButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="📁 IMPORTER UN MODÈLE STABLE DIFFUSION"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:gravity="center"
                android:background="@drawable/bg_input"
                android:layout_marginBottom="16dp" />

        </LinearLayout>

    </LinearLayout>

    </ScrollView>

    <include layout="@layout/bottom_nav_bar" />

</LinearLayout>

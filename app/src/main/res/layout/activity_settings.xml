<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_app_gradient">

    <RelativeLayout
        android:id="@+id/settingsTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            android:background="@drawable/bg_icon_button"
            android:src="@drawable/ic_back"
            android:contentDescription="@string/settings_title"
            android:padding="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="@string/settings_title"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

    <!-- Personnalisation "vrai dialogue" (axe voix/personnalite JARVIS) : le prenom sert a
         personnaliser le preambule envoye au backend IA conversationnel (voir
         MainActivity.buildConversationalPrompt). Section en tete des Reglages : c'est la
         chose la plus simple qui rend chaque reponse un peu plus "vraie". -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/personalization_section_label"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp" />

    <EditText
        android:id="@+id/userNameInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_hf_token_input"
        android:hint="@string/user_name_hint"
        android:textColorHint="@color/text_hint"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:inputType="textCapWords|textNoSuggestions"
        android:maxLines="1"
        android:padding="14dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/user_name_help"
        android:textColor="@color/text_hint"
        android:textSize="12sp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="6dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/settings_color_label"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginStart="12dp">

        <FrameLayout android:id="@+id/swatchCyan" android:layout_width="48dp" android:layout_height="48dp" android:layout_margin="8dp">
            <View android:id="@+id/swatchCyanCircle" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_color_swatch" />
            <ImageView android:id="@+id/swatchCyanCheck" android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:src="@drawable/ic_check" android:visibility="gone" android:contentDescription="@null" />
        </FrameLayout>

        <FrameLayout android:id="@+id/swatchViolet" android:layout_width="48dp" android:layout_height="48dp" android:layout_margin="8dp">
            <View android:id="@+id/swatchVioletCircle" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_color_swatch" />
            <ImageView android:id="@+id/swatchVioletCheck" android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:src="@drawable/ic_check" android:visibility="gone" android:contentDescription="@null" />
        </FrameLayout>

        <FrameLayout android:id="@+id/swatchRose" android:layout_width="48dp" android:layout_height="48dp" android:layout_margin="8dp">
            <View android:id="@+id/swatchRoseCircle" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_color_swatch" />
            <ImageView android:id="@+id/swatchRoseCheck" android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:src="@drawable/ic_check" android:visibility="gone" android:contentDescription="@null" />
        </FrameLayout>

        <FrameLayout android:id="@+id/swatchVert" android:layout_width="48dp" android:layout_height="48dp" android:layout_margin="8dp">
            <View android:id="@+id/swatchVertCircle" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_color_swatch" />
            <ImageView android:id="@+id/swatchVertCheck" android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:src="@drawable/ic_check" android:visibility="gone" android:contentDescription="@null" />
        </FrameLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginStart="12dp">

        <FrameLayout android:id="@+id/swatchOrange" android:layout_width="48dp" android:layout_height="48dp" android:layout_margin="8dp">
            <View android:id="@+id/swatchOrangeCircle" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_color_swatch" />
            <ImageView android:id="@+id/swatchOrangeCheck" android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:src="@drawable/ic_check" android:visibility="gone" android:contentDescription="@null" />
        </FrameLayout>

        <FrameLayout android:id="@+id/swatchRouge" android:layout_width="48dp" android:layout_height="48dp" android:layout_margin="8dp">
            <View android:id="@+id/swatchRougeCircle" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_color_swatch" />
            <ImageView android:id="@+id/swatchRougeCheck" android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:src="@drawable/ic_check" android:visibility="gone" android:contentDescription="@null" />
        </FrameLayout>

        <FrameLayout android:id="@+id/swatchBleu" android:layout_width="48dp" android:layout_height="48dp" android:layout_margin="8dp">
            <View android:id="@+id/swatchBleuCircle" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_color_swatch" />
            <ImageView android:id="@+id/swatchBleuCheck" android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:src="@drawable/ic_check" android:visibility="gone" android:contentDescription="@null" />
        </FrameLayout>

        <FrameLayout android:id="@+id/swatchBlanc" android:layout_width="48dp" android:layout_height="48dp" android:layout_margin="8dp">
            <View android:id="@+id/swatchBlancCircle" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_color_swatch" />
            <ImageView android:id="@+id/swatchBlancCheck" android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:src="@drawable/ic_check" android:visibility="gone" android:contentDescription="@null" />
        </FrameLayout>

    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/settings_model_label"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:id="@+id/modelGeminiNanoRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_model_row"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/model_gemini_nano_name"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/model_gemini_nano_desc"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />

        </LinearLayout>

        <ImageView
            android:id="@+id/modelGeminiNanoCheck"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_check"
            android:visibility="gone"
            android:contentDescription="@null" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/modelGemmaRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_model_row"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/model_local_llm_name"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/model_local_llm_desc"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />

        </LinearLayout>

        <ImageView
            android:id="@+id/modelGemmaCheck"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_check"
            android:visibility="gone"
            android:contentDescription="@null" />

    </LinearLayout>

    <TextView
        android:id="@+id/gemmaConfigSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/local_llm_models_label"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="8dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/localModelsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone" />

    <!-- Connexion Google directement depuis l'appli (Agenda + Mail, voir
         GoogleAccountController/GoogleCalendarApiController/GmailApiController) : demande
         explicite de l'utilisateur de repasser sur l'API officielle OAuth plutôt que
         CalendarContract/IMAP (ceux-ci restent dans le dépôt, inutilisés). L'ID client Web
         (Google Cloud Console, créé par l'utilisateur lui-même) reste une saisie manuelle
         obligatoire, comme le jeton Hugging Face ci-dessus : jamais codé en dur. -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/google_account_section_label"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="8dp" />

    <EditText
        android:id="@+id/googleWebClientIdInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_hf_token_input"
        android:hint="@string/google_web_client_id_hint"
        android:textColorHint="@color/text_hint"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:inputType="textNoSuggestions"
        android:maxLines="1"
        android:padding="14dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/google_web_client_id_help"
        android:textColor="@color/text_hint"
        android:textSize="12sp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="8dp" />

    <LinearLayout
        android:id="@+id/googleAccountsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="14dp" />

    <TextView
        android:id="@+id/addGoogleAccountButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/google_add_account_button"
        android:textColor="@color/accent_default"
        android:textSize="14sp"
        android:textStyle="bold"
        android:gravity="center"
        android:background="@drawable/bg_new_conversation"
        android:padding="12dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="10dp" />

    <!-- Vault Obsidian (systeme de notes/second brain, voir ObsidianController) : dossier
         reel choisi par l'utilisateur via SAF (Storage Access Framework), pas un dossier
         interne cree par l'appli : demande explicite "vault reel". -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/obsidian_section_label"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/obsidianVaultStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/obsidian_no_vault"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp" />

    <TextView
        android:id="@+id/chooseObsidianVaultButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/obsidian_choose_vault_button"
        android:textColor="@color/accent_default"
        android:textSize="14sp"
        android:textStyle="bold"
        android:gravity="center"
        android:background="@drawable/bg_new_conversation"
        android:padding="12dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="10dp" />

    </LinearLayout>
    </ScrollView>

</LinearLayout>

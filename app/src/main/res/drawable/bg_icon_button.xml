<?xml version="1.0" encoding="utf-8"?>
<!-- Boutons icône ronds de l'en-tête (menu, contrôle, obsidian, maison, réglages...) :
     remplace les carrés plats d'origine par un cercle discret avec liseré et ondulation
     tactile, plus cohérent avec le reste de la refonte et plus agréable à toucher. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/ripple_cyan">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/surface_dark_2" />
            <stroke android:width="1dp" android:color="#3300E5FF" />
        </shape>
    </item>
</ripple>

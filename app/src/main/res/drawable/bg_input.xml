<?xml version="1.0" encoding="utf-8"?>
<!-- Fond réutilisé partout : champs de saisie, cartes, boutons secondaires,
     lignes d'historique. Dégradé sombre subtil + liseré cyan lumineux + ondulation
     tactile au toucher (visible sur les éléments cliquables, invisible/neutre sur
     les simples champs de texte). -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/ripple_cyan">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="@color/surface_dark_2"
                android:endColor="@color/surface_dark" />
            <stroke android:width="1dp" android:color="@color/cyan_dim" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</ripple>

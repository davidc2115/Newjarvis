<?xml version="1.0" encoding="utf-8"?>
<!-- Carte "pro" réutilisée pour les blocs de contenu structurés (Clés API, IA locale) :
     fond légèrement plus clair que l'arrière-plan général + liseré fin ambre discret +
     coins bien arrondis, façon panneau de dashboard. Contrairement à bg_input (pensé pour
     les champs de saisie et boutons cliquables, avec ripple), celle-ci sert de simple
     conteneur visuel non cliquable — pas d'effet tactile. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="90"
        android:startColor="@color/surface_dark_2"
        android:endColor="@color/surface_dark" />
    <stroke android:width="1dp" android:color="@color/cyan_dim" />
    <corners android:radius="18dp" />
</shape>

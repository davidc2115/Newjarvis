<?xml version="1.0" encoding="utf-8"?>
<!-- Bouton d'action rapide sous une bulle de chat (Appeler/SMS/Itinéraire/Mail) — pilule
     discrète cohérente avec le thème Apex Studio, avec un léger effet au clic. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33E8B84B">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1FE8B84B" />
            <stroke android:width="1dp" android:color="@color/violet_dim" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</ripple>
